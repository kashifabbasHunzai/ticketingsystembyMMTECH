{
 "name": "fanan-tickets",
 "private": true,
 "version": "1.0.0",
 "type": "module",
 "scripts": {
  "dev": "vite",
  "build": "vite build",
  "test:logic": "node tests/logic.test.mjs",
  "test:rules": "firebase emulators:exec --only firestore --project demo-fanan \"node tests/rules.test.mjs\"",
  "test": "npm run lint && npm run test:logic && npm run test:app && npm run test:rules",
  "test:app": "vitest run tests/booking.spec.mjs",
  "lint": "eslint src --ext .js,.jsx"
 },
 "dependencies": {
  "firebase": "^13.2.0",
  "jsqr": "^1.4.0",
  "qrcode": "^1.5.4",
  "qrcode.react": "^4.1.0",
  "react": "^18.3.1",
  "react-dom": "^18.3.1",
  "react-router-dom": "^7.18.5"
 },
 "devDependencies": {
  "@firebase/rules-unit-testing": "^6.0.0",
  "@vitejs/plugin-react": "^4.3.2",
  "eslint": "^8.57.1",
  "eslint-plugin-react": "^7.37.5",
  "eslint-plugin-react-hooks": "^4.6.2",
  "vite": "^5.4.8",
  "vitest": "^2.1.9"
 }
}